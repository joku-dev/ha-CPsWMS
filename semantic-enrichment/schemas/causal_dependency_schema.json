{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "causal_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context_entity_id": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["entity", "automation", "capability", "incident"]
          },
          "source_id": { "type": "string" },
          "target_type": {
            "type": "string",
            "enum": ["entity", "automation", "capability", "incident"]
          },
          "target_id": { "type": "string" },
          "relationship_type": {
            "type": "string",
            "enum": ["CAUSES", "DEPENDS_ON", "IMPACTS", "DEGRADES", "RECOVERS"]
          },
          "causal_stage": {
            "type": "string",
            "enum": ["cause", "dependency", "impact", "degradation", "recovery", "unknown"]
          },
          "event_time": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": { "type": "string" }
        },
        "required": [
          "context_entity_id",
          "source_type",
          "source_id",
          "target_type",
          "target_id",
          "relationship_type",
          "causal_stage",
          "event_time",
          "confidence",
          "reason"
        ]
      }
    }
  },
  "required": ["causal_links"]
}
