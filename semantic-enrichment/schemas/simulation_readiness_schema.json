{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "readiness_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scenario_id": { "type": "string" },
          "scenario_type": {
            "type": "string",
            "enum": ["integration_outage", "capability_loss", "entity_failure"]
          },
          "target_type": {
            "type": "string",
            "enum": ["integration", "capability", "entity"]
          },
          "target_id": { "type": "string" },
          "target_name": { "type": "string" },
          "readiness": {
            "type": "string",
            "enum": ["ready", "partial", "not_ready", "unknown"]
          },
          "coverage_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "missing_data": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supported_questions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_next_steps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": { "type": "string" }
        },
        "required": [
          "scenario_id",
          "scenario_type",
          "target_type",
          "target_id",
          "target_name",
          "readiness",
          "coverage_score",
          "missing_data",
          "supported_questions",
          "required_next_steps",
          "confidence",
          "reason"
        ]
      }
    }
  },
  "required": ["readiness_assessments"]
}
