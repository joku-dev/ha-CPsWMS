{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "temporal_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": { "type": "string" },
          "observation_text": { "type": "string" },
          "observed_at": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "transition_from": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "transition_to": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "transition_at": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "timeline_event_type": {
            "type": "string",
            "enum": [
              "state_change",
              "sensor_unavailable",
              "automation_triggered",
              "incident",
              "observation",
              "unknown"
            ]
          },
          "timeline_summary": { "type": "string" },
          "timeline_at": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "incident_type": {
