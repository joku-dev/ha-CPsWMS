          },
          "incident_severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical", "unknown"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": { "type": "string" }
        },
        "required": [
          "entity_id",
          "observation_text",
          "observed_at",
          "transition_from",
          "transition_to",
          "transition_at",
          "timeline_event_type",
          "timeline_summary",
          "timeline_at",
          "incident_type",
          "incident_severity",
          "confidence",
          "reason"
        ]
      }
    }
